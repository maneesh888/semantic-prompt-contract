{
  "name": "semantic-prompt-contract",
  "version": "2.0.3",
  "description": "Platform-neutral semantic prompt contracts and deterministic adapters",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./contracts/*": "./contracts/*",
    "./schemas/*": "./schemas/*",
    "./fixtures/*": "./fixtures/*"
  },
  "files": [
    "adapters",
    "contracts",
    "fixtures",
    "schemas",
    "src",
    "Package.swift",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "generate": "node scripts/generate-adapters.mjs",
    "check:generated": "node scripts/generate-adapters.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run check:generated && npm test && npm run check:package"
  },
  "devDependencies": {
    "ajv": "^8.17.1"
  },
  "license": "MIT"
}
