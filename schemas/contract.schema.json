{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-prompt-contract.local/schemas/contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "contract_version", "id", "description", "system_instruction", "user_message_template", "rule_line_template", "input", "response", "operations"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
    "description": {"type": "string", "minLength": 1},
    "system_instruction": {"type": "string", "minLength": 1},
    "unstructured_system_instruction": {"type": "string", "minLength": 1},
    "plain_text_system_instruction_template": {"type": "string", "minLength": 1},
    "plain_text_validation_profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode",
          "reject_unchanged",
          "preserve_boundary_whitespace",
          "preserve_line_breaks",
          "reject_new_markdown_fences",
          "reject_commentary",
          "reject_raw_error_text",
          "reject_source_fragment",
          "minimum_length_ratio",
          "maximum_length_ratio",
          "maximum_added_characters",
          "minimum_word_overlap_ratio",
          "protected_token_types"
        ],
        "properties": {
          "mode": {"const": "complete_replacement"},
          "reject_unchanged": {"type": "boolean"},
          "preserve_boundary_whitespace": {"type": "boolean"},
          "preserve_line_breaks": {"type": "boolean"},
          "reject_new_markdown_fences": {"type": "boolean"},
          "reject_commentary": {"type": "boolean"},
          "reject_raw_error_text": {"type": "boolean"},
          "reject_source_fragment": {"type": "boolean"},
          "minimum_length_ratio": {"type": "number", "minimum": 0, "maximum": 1},
          "maximum_length_ratio": {"type": "number", "minimum": 1},
          "maximum_added_characters": {"type": "integer", "minimum": 0},
          "minimum_word_overlap_ratio": {"type": "number", "minimum": 0, "maximum": 1},
          "protected_token_types": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": ["number", "url", "email", "mention", "hashtag", "emoji", "markdown_link_destination"]
            }
          }
        }
      }
    },
    "user_message_template": {"type": "string", "minLength": 1},
    "rule_line_template": {"type": "string", "minLength": 1},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter", "required", "encoding", "trust"],
      "properties": {
        "parameter": {"type": "string"},
        "required": {"type": "boolean"},
        "encoding": {"const": "json_string"},
        "trust": {"const": "untrusted_data"},
        "max_characters": {"type": "integer", "minimum": 1},
        "max_characters_unit": {"const": "unicode_scalar"}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "schema", "top_level_example"],
      "properties": {
        "format": {"enum": ["json_object", "prompt_only_json"]},
        "schema": {"type": "string"},
        "top_level_example": {"type": "string", "minLength": 2}
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "wire_operation_id", "description", "parameters", "max_tokens", "result_types", "rules", "no_change_behavior"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
          "wire_operation_id": {"type": ["string", "null"]},
          "description": {"type": "string", "minLength": 1},
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type", "required"],
              "properties": {
                "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
                "type": {"const": "string"},
                "required": {"type": "boolean"},
                "trim": {"type": "boolean"},
                "trim_characters": {"const": "ascii_whitespace"},
                "default": {"type": "string"},
                "max_length": {"type": "integer", "minimum": 1},
                "max_length_unit": {"const": "unicode_scalar"},
                "pattern": {"type": "string", "minLength": 1}
              }
            }
          },
          "system_instruction": {"type": "string", "minLength": 1},
          "plain_text_instruction": {"type": "string", "minLength": 1},
          "user_message_mode": {"enum": ["template", "raw_input"]},
          "response_format": {"enum": ["json_object", "plain_text"]},
          "temperature": {"type": ["number", "null"], "minimum": 0},
          "plain_text_validation_profile": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
          "max_tokens": {"type": "integer", "minimum": 1},
          "result_types": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "rules": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "no_change_behavior": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
