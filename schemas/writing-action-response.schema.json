{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-prompt-contract.local/schemas/writing-action-response.schema.json",
  "$comment": "Deprecated: retained at its stable path and unchanged response shape for semantic-prompt-contract 4.x compatibility. No 5.x writing rendering or preset references this schema.",
  "title": "Legacy writing-action response envelope (4.x compatibility only)",
  "description": "Deprecated compatibility schema for consumers that still decode semantic-prompt-contract 4.x writing-action envelopes. Version 5 writing operations return plain text and do not reference this schema.",
  "deprecated": true,
  "type": "object",
  "additionalProperties": true,
  "required": ["operation", "results"],
  "properties": {
    "operation": {"type": "string", "minLength": 1},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "type", "title", "text"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"enum": ["correction", "suggestion", "summary", "translation", "warning", "explanation"]},
          "title": {"type": "string", "minLength": 1},
          "text": {"type": "string"},
          "original": {"type": "string"},
          "replacement": {"type": "string"},
          "range": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start", "end"],
            "properties": {
              "start": {"type": "integer", "minimum": 0},
              "end": {"type": "integer", "minimum": 0}
            }
          },
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "explanation": {"type": "string"},
          "category": {"type": "string"}
        }
      }
    },
    "summary": {"type": "string"},
    "corrected_text": {"type": "string"}
  }
}
