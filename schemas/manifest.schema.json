{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-prompt-contract.local/schemas/manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "contract_version", "packs"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "response_schema"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
          "path": {"type": "string"},
          "response_schema": {"type": "string"}
        }
      }
    }
  }
}
